---
import trip from "../data/trip.json";

type Place = (typeof trip.places)[number];
type InlinePart = { text: string; place?: Place };

interface Props {
  text: string;
  places: Place[];
  id: string;
}

const { text, places, id } = Astro.props;
const aliases: Record<string, string[]> = {
  "Pererenan": ["Pererenan"],
  "Potato Head Beach Club": ["Potato Head"],
  "Mount Batur": ["Batur"],
  "Nuanu Creative City": ["Nuanu", "Нуа́ну", "Нуану"],
  "Splash Waterpark Bali": ["Splash", "аквапарк Splash"],
  "Cemagi Beach": ["Cemagi", "пляж Cemagi"],
  "Gili Trawangan": ["Gili T", "Trawangan"],
  "Gili Air": ["Gili Air"],
  "Gili Meno": ["Gili Meno", "Meno"],
  "Станция метро Саньча (三岔站)": ["станции метро Саньча (三岔站)", "станцию метро Саньча (三岔站)", "метро Саньча", "三岔站"],
  "Вход №1 в парк Всемирной садовой выставки": ["входа №1 в парк Всемирной садовой выставки", "входу №1 в парк Всемирной садовой выставки", "вход №1"],
  "Сад Чэнду (成都园)": ["Сада Чэнду (成都园)", "Саду Чэнду (成都园)", "成都园"],
  "Башня Цзиньюнь (锦云楼)": ["башни Цзиньюнь (锦云楼)", "башню Цзиньюнь (锦云楼)", "Цзиньюнь", "锦云楼"],
  "Linqi Vitality City (林栖·活力城)": ["Linqi Vitality City", "Linqi", "林栖·活力城"]
};
const getMapsUrl = (place: Place) => place.mapsUrl ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${place.name}, Bali, Indonesia`)}`;
const terms = places
  .filter((place) => !place.badges.includes("TBD"))
  .flatMap((place) => [place.name, ...(aliases[place.name] ?? [])].map((term) => ({ place, term })))
  .filter(({ term }) => term.length > 2)
  .sort((left, right) => right.term.length - left.term.length);
const lowerText = text.toLocaleLowerCase("ru");
const parts: InlinePart[] = [];
let cursor = 0;

while (cursor < text.length) {
  let match: { place: Place; term: string; index: number } | undefined;

  for (const candidate of terms) {
    const index = lowerText.indexOf(candidate.term.toLocaleLowerCase("ru"), cursor);
    if (index < 0 || (match && index > match.index) || (match && index === match.index && candidate.term.length <= match.term.length)) continue;
    match = { ...candidate, index };
  }

  if (!match) {
    parts.push({ text: text.slice(cursor) });
    break;
  }

  if (match.index > cursor) parts.push({ text: text.slice(cursor, match.index) });
  parts.push({ text: text.slice(match.index, match.index + match.term.length), place: match.place });
  cursor = match.index + match.term.length;
}
---

{parts.map((part, index) => part.place ? (
  <span class="inline-place" data-inline-place>
    <button
      class="inline-place-trigger"
      type="button"
      aria-expanded="false"
      aria-controls={`${id}-place-${index}`}
      data-inline-place-trigger
    >{part.text}</button>
    <span id={`${id}-place-${index}`} class="inline-place-popover" data-inline-place-popover hidden>
      <span class="inline-place-description">{part.place.description} {part.place.familyNote}</span>
      <a href={getMapsUrl(part.place)} target="_blank" rel="noreferrer">Google Maps</a>
    </span>
  </span>
) : part.text)}
