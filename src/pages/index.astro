---
import RouteMap from "../components/RouteMap.astro";
import trip from "../data/trip.json";
import "../styles/global.css";

const baseUrl = import.meta.env.BASE_URL;
const totalNights = trip.bases.reduce((sum, base) => sum + base.nights, 0);
const accommodationMoves = Math.max(trip.bases.length - 1, 0);
const plural = (count: number, forms: [string, string, string]) => {
  const remainder = count % 100;
  const last = count % 10;
  if (remainder > 10 && remainder < 20) return forms[2];
  if (last === 1) return forms[0];
  if (last > 1 && last < 5) return forms[1];
  return forms[2];
};
const formatNights = (count: number) => `${count} ${plural(count, ["ночь", "ночи", "ночей"])}`;
const formatMoves = (count: number) => `${count} ${plural(count, ["переезд", "переезда", "переездов"])}`;
const placesByBase = trip.bases.map((base) => ({
  base,
  places: trip.places.filter((place) => place.base === base.name)
}));
const dayDetailsByDate = new Map(trip.dayDetails.map((detail) => [detail.date, detail]));
type Place = (typeof trip.places)[number];
type Day = (typeof trip.days)[number];
type DayDetail = (typeof trip.dayDetails)[number];
const placeAliases: Record<string, string[]> = {
  "Tegallalang Rice Terraces": ["Tegallalang", "рисовые террасы"],
  "Пляж Ayodya": ["Ayodya", "пляж Ayodya"],
  "Tsavo Lion Restaurant": ["Tsavo", "Bali Safari", "ужин со львами"],
  "Подводные статуи BASK NEST": ["статуи", "BASK", "BASK NEST"],
  "Mowie’s Gili Air — туна-стейк": ["Mowie", "туна-стейк", "туна стейк"],
  "SANDS Beach Club": ["SANDS", "SANDS Bakery"],
  "Single Fin Bali": ["Single Fin", "16:00"],
  "SUKA ULUWATU": ["SUKA"]
};
const normalize = (value: string) => value.toLowerCase().replaceAll("’", "'").replace(/[^a-zа-яё0-9]+/giu, " ").trim();
const getDayTone = (day: Day) => {
  const base = normalize(day.base);

  if (base.includes("москва") || base.includes("chengdu")) return "travel";
  if (base.includes("ubud")) return "forest";
  if (base.includes("uluwatu") || base.includes("bukit")) return "cliff";
  if (base === "umalas" || base.includes("umalas berawa canggu")) return "ceremony";

  return "coast";
};
const includesTerm = (text: string, term: string) => {
  const normalizedTerm = normalize(term);
  return normalizedTerm.length > 2 && normalize(text).includes(normalizedTerm);
};
const getPlaceTerms = (place: Place) => [
  place.name,
  ...(placeAliases[place.name] ?? []),
  ...place.name.split(/\s*(?:\/|\+)\s*/u)
];
const getDayPlaces = (day: Day, details?: DayDetail) => {
  const detailText = details
    ? [
        ...details.timing,
        details.focus,
        details.fallback,
        details.foodRest,
        ...details.warnings
      ].join(" ")
    : "";
  const dayText = [day.title, day.plan, day.notes, detailText].join(" ");

  return trip.places.filter((place) => place.base === day.base && getPlaceTerms(place).some((term) => includesTerm(dayText, term)));
};
const getGoogleMapsSearchUrl = (query: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${query}, Bali, Indonesia`)}`;
const getMapsSearchUrl = (place: Place) => place.mapsUrl ?? getGoogleMapsSearchUrl(place.name);
const isNavigablePlace = (place: Place) => !place.badges.includes("TBD");
const tripNowPayload = JSON.stringify({
  year: 2026,
  days: trip.days.map((day, index) => ({
    ...day,
    index,
    id: `day-${index + 1}`
  }))
});
const navItems = [
  ["now", "Сейчас"],
  ["days", "Дни"],
  ["bases", "Базы"],
  ["map", "Карта"],
  ["transfers", "Переезды"],
  ["places", "Места"],
  ["planning", "Подготовка"]
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Семейный маршрут поездки на Бали 2026: карта, базы, дни и переезды." />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg?v=1`} />
    <title>{trip.title} - маршрут</title>
  </head>
  <body>
    <header class="hero">
      <nav class="topbar" aria-label="Основная навигация">
        <a href={baseUrl} class="brand">Bali 2026</a>
        <div>
          <a href="#now">Сейчас</a>
          <a href="#days">Дни</a>
          <a href="#map">Карта</a>
        </div>
      </nav>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Семейная поездка</p>
          <h1>{trip.title}</h1>
          <p class="lead">{trip.subtitle}</p>
          <p>{trip.summary.coreIdea}</p>
        </div>
        <aside class="trip-facts" aria-label="Краткая сводка">
          <div>
            <span>Свадьба</span>
            <strong>{trip.summary.weddingDate}</strong>
          </div>
          <div>
            <span>Бали</span>
            <strong>{totalNights} ночей</strong>
          </div>
          <div>
            <span>Жильё</span>
            <strong>{trip.bases.length} точек</strong>
          </div>
          <div>
            <span>Смены жилья</span>
            <strong>{formatMoves(accommodationMoves)}</strong>
          </div>
        </aside>
      </div>
      <div class="hero-route" aria-label={`Маршрут из ${trip.bases.length} баз`}>
        <p>{trip.bases.length} баз · один спокойный маршрут</p>
        <ol>
          {trip.bases.map((base) => (
            <li class={`route-stop--${base.order}`}>
              <span>{String(base.order).padStart(2, "0")}</span>
              <strong>{base.name}</strong>
              <small>{base.dates}</small>
            </li>
          ))}
        </ol>
      </div>
    </header>

    <section id="now" class="trip-now" aria-labelledby="trip-now-title">
      <div class="trip-now-copy">
        <p class="eyebrow">Быстрый план в поездке</p>
        <p id="trip-now-status" class="trip-now-status">Маршрут начинается 18 октября 2026</p>
        <h2 id="trip-now-title">Дом → SVO C → Chengdu</h2>
        <p id="trip-now-base" class="trip-now-base">18 Oct · Москва / перелёт</p>
        <p id="trip-now-plan" class="trip-now-plan">Выехать из Солнцево, быть в Шереметьево Terminal C примерно к 18:45-19:00, сдать багаж и спокойно ждать рейс 22:20.</p>
        <p id="trip-now-note" class="trip-now-note">Семейный вариант по умолчанию — такси. Rail/Aeroexpress можно перепроверить ближе к дате.</p>
      </div>
      <div class="trip-now-actions" aria-label="Быстрые действия маршрута">
        <a id="trip-now-day-link" class="primary-action" href="#day-1">Открыть день 18 Oct</a>
        <a class="secondary-action" href="#days">Все дни</a>
        <a class="secondary-action" href="#map">Карта маршрута</a>
      </div>
      <p id="trip-now-next" class="trip-now-next">Следом: прилёт на Бали и отдых.</p>
    </section>

    <nav class="section-tabs" aria-label="Разделы маршрута">
      {navItems.map(([href, label]) => <a href={`#${href}`}>{label}</a>)}
    </nav>

    <main>
      <section id="days" class="section">
        <div class="section-head">
          <p class="eyebrow">План по дням</p>
          <h2>Выбери дату — увидишь только нужный день</h2>
          <label class="day-picker-label" for="day-picker">
            <span>Быстрый переход</span>
            <select id="day-picker">
              {trip.days.map((day, index) => <option value={index}>{day.date} · {day.title}</option>)}
            </select>
          </label>
          <aside class="personal-tools" aria-labelledby="personal-tools-title">
            <div>
              <p class="personal-kicker">Личные записи</p>
              <h3 id="personal-tools-title">Только на этом устройстве</h3>
              <p>Добавляй заметки, тайминг, checklist и контакты в нужный день. Они не меняют маршрут или карту и не отправляются на сервер.</p>
            </div>
            <div class="personal-tools-actions">
              <button id="personal-export" class="personal-action" type="button">Экспортировать</button>
              <label class="personal-import-label">
                <span>Импортировать</span>
                <input id="personal-import" type="file" accept="application/json,.json" />
              </label>
              <button id="personal-clear-all" class="personal-action personal-action--quiet" type="button">Очистить всё</button>
            </div>
            <p id="personal-storage-status" class="personal-storage-status" aria-live="polite"></p>
          </aside>
        </div>
        <div class="timeline">
          {trip.days.map((day, index) => {
            const details = dayDetailsByDate.get(day.date);
            const dayPlaces = getDayPlaces(day, details);
            return (
              <article id={`day-${index + 1}`} class={`day-card day-card--${getDayTone(day)}`}>
                <div class="date-box">
                  <strong>{day.date}</strong>
                  <span>{day.weekday}</span>
                </div>
                <div>
                  <p class="day-base">{day.base}</p>
                  <h3>{day.title}</h3>
                  <p>{day.plan}</p>
                  <p class="note">{day.notes}</p>
                  {dayPlaces.length > 0 && (
                    <details class="day-places">
                      <summary>Места дня · {dayPlaces.length}</summary>
                      <div class="day-place-grid">
                        {dayPlaces.map((place) => (
                          <article class="day-place">
                            <div>
                              <strong>{place.name}</strong>
                              <small>{place.duration}</small>
                            </div>
                            <p>{place.description}</p>
                            <p class="note">{place.familyNote}</p>
                            {isNavigablePlace(place) && <a class="maps-link" href={getMapsSearchUrl(place)} target="_blank" rel="noreferrer">Открыть в Google Maps</a>}
                          </article>
                        ))}
                      </div>
                    </details>
                  )}
                  {details && (
                    <details class="day-details">
                      <summary>Показать детали дня</summary>
                      <div class="detail-grid">
                        <section>
                          <h4>Тайминг</h4>
                          <ul>
                            {details.timing.map((item) => <li>{item}</li>)}
                          </ul>
                        </section>
                        <section>
                          <h4>Смысл дня</h4>
                          <p>{details.focus}</p>
                        </section>
                        <section>
                          <h4>Fallback</h4>
                          <p>{details.fallback}</p>
                        </section>
                        <section>
                          <h4>Еда / отдых</h4>
                          <p>{details.foodRest}</p>
                        </section>
                        <section>
                          <h4>Важно</h4>
                          <ul>
                            {details.warnings.map((item) => <li>{item}</li>)}
                          </ul>
                        </section>
                      </div>
                    </details>
                  )}
                  <section class="personal-day" data-personal-day data-day-id={`day-${index + 1}`} data-day-label={`${day.date} · ${day.title}`} aria-labelledby={`personal-day-heading-${index + 1}`}>
                    <div class="personal-day-head">
                      <div>
                        <p class="personal-kicker">Личные записи на этом устройстве</p>
                        <h4 id={`personal-day-heading-${index + 1}`}>Мой план и контакты</h4>
                      </div>
                      <button class="personal-edit" type="button" aria-controls={`personal-form-${index + 1}`} aria-expanded="false">Редактировать</button>
                    </div>
                    <p class="personal-empty" data-personal-empty>Пока пусто. Здесь можно сохранить оперативные детали для этого дня.</p>
                    <div class="personal-summary" data-personal-summary hidden>
                      <p class="personal-note" data-personal-note hidden></p>
                      <section data-personal-timing-block hidden>
                        <h5>Личный тайминг</h5>
                        <ul data-personal-timing></ul>
                      </section>
                      <section data-personal-checklist-block hidden>
                        <h5>Checklist</h5>
                        <ul data-personal-checklist></ul>
                      </section>
                      <section data-personal-links-block hidden>
                        <h5>Ссылки и контакты</h5>
                        <ul data-personal-links></ul>
                      </section>
                    </div>
                    <form id={`personal-form-${index + 1}`} class="personal-day-form" data-personal-form hidden>
                      <label>
                        <span>Заметка</span>
                        <textarea name="note" rows="3" placeholder="Например: написать водителю после завтрака"></textarea>
                      </label>
                      <label>
                        <span>Личный тайминг</span>
                        <textarea name="timing" rows="3" placeholder="Каждая строка — отдельный пункт"></textarea>
                      </label>
                      <label>
                        <span>Checklist</span>
                        <textarea name="checklist" rows="3" placeholder="Каждая строка — отдельная задача"></textarea>
                      </label>
                      <label>
                        <span>Ссылка или контакт</span>
                        <textarea name="links" rows="3" placeholder="Каждая строка: название | ссылка или текст"></textarea>
                      </label>
                      <p class="personal-form-note">Эти значения видны только в этом браузере. Для переноса на другой телефон используй экспорт выше.</p>
                      <div class="personal-form-actions">
                        <button class="personal-save" type="submit">Сохранить</button>
                        <button class="personal-cancel" type="button">Отмена</button>
                        <button class="personal-clear-day" type="button">Очистить день</button>
                      </div>
                    </form>
                  </section>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section id="bases" class="section">
        <div class="section-head">
          <p class="eyebrow">Базы проживания</p>
          <h2>{trip.bases.length} точек проживания и {accommodationMoves} переездов между ними</h2>
        </div>
        <div class="base-grid">
          {trip.bases.map((base) => (
            <article class={`base-card base-card--${base.order}`}>
              <div class="card-topline">
                <span>{String(base.order).padStart(2, "0")}</span>
                <small>{base.dates} · {formatNights(base.nights)}</small>
              </div>
              <h3>{base.name}</h3>
              <p class="role">{base.role}</p>
              <p>{base.why}</p>
              {base.accommodation.options.length > 0 ? (
                <div class="accommodation-options" aria-label={`Варианты размещения: ${base.name}`}>
                  <strong>Варианты размещения</strong>
                  {base.accommodation.options.map((option) => (
                    <div class="accommodation-option">
                      <a class="maps-link" href={option.url} target="_blank" rel="noreferrer">
                        {option.name} · {option.priority}
                      </a>
                      <a class="maps-link accommodation-maps-link" href={getGoogleMapsSearchUrl(option.name)} target="_blank" rel="noreferrer" aria-label={`Открыть ${option.name} в Google Maps`}>
                        Открыть в Google Maps
                      </a>
                    </div>
                  ))}
                </div>
              ) : (
                <p class="accommodation-note">{base.accommodation.status === "private" ? "Жильё в этом блоке — частное; название и адрес не публикуются." : "Вариант жилья ещё нужно подтвердить."}</p>
              )}
              <div class="chips">
                {base.nearby.map((item) => {
                  const place = trip.places.find((entry) => entry.name === item || item.includes(entry.name) || entry.name.includes(item));
                  return place && isNavigablePlace(place) ? (
                    <a class="place-chip" href={getMapsSearchUrl(place)} target="_blank" rel="noreferrer" title={place.description}>
                      {item}
                    </a>
                  ) : <span>{item}</span>;
                })}
              </div>
            </article>
          ))}
        </div>
      </section>

      <div id="map">
        <RouteMap />
      </div>

      <section id="places" class="section">
        <div class="section-head">
          <p class="eyebrow">Справочник мест</p>
          <h2>Что означают все названия в маршруте</h2>
          <p>Здесь каждая точка расшифрована простым языком: что это, зачем туда ехать, сколько занимает и что важно для семьи.</p>
        </div>
        <div class="places-groups">
          {placesByBase.map(({ base, places }) => (
            <section class="place-group">
              <div class="place-group-head">
                <span>{String(base.order).padStart(2, "0")}</span>
                <div>
                  <h3>{base.name}</h3>
                  <p>{base.role}</p>
                </div>
              </div>
              <div class="place-list">
                {places.map((place) => (
                  <article class="place-card">
                    <div class="place-title">
                      <h4>{place.name}</h4>
                      <small>{place.duration}</small>
                    </div>
                    <div class="badges">
                      {place.badges.map((badge) => <span class={`badge ${badge.replaceAll(" ", "-")}`}>{badge}</span>)}
                    </div>
                    <p>{place.description}</p>
                    <p class="note">{place.familyNote}</p>
                    {isNavigablePlace(place) && <a class="maps-link" href={getMapsSearchUrl(place)} target="_blank" rel="noreferrer">Открыть в Google Maps</a>}
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </section>

      <section id="transfers" class="section">
        <div class="section-head">
          <p class="eyebrow">Логистика</p>
          <h2>Главные переезды и окна выезда</h2>
        </div>
        <div class="transfer-list">
          {trip.transfers.map((transfer) => (
            <article class="transfer-card">
              <h3>{transfer.from} -> {transfer.to}</h3>
              <dl>
                <div>
                  <dt>Расстояние</dt>
                  <dd>{transfer.distance}</dd>
                </div>
                <div>
                  <dt>Время</dt>
                  <dd>{transfer.time}</dd>
                </div>
                <div>
                  <dt>Транспорт</dt>
                  <dd>{transfer.transport}</dd>
                </div>
                <div>
                  <dt>Когда ехать</dt>
                  <dd>{transfer.window}</dd>
                </div>
              </dl>
              <p>{transfer.note}</p>
              {transfer.bookingUrl && <a class="maps-link" href={transfer.bookingUrl} target="_blank" rel="noreferrer">{transfer.bookingLabel}</a>}
            </article>
          ))}
        </div>
      </section>

      <section id="planning" class="section planning-section">
        <div class="section-head">
          <p class="eyebrow">Подготовка</p>
          <h2>Перелёты, бюджет и открытые решения</h2>
          <p>Эти блоки нужны для обсуждения и бронирований. В поездке основной сценарий — «Сейчас» и «Дни» выше.</p>
        </div>
        <div class="flight-grid">
          {trip.flights.map((flight) => (
            <article class="flight-card">
              <div class="card-topline">
                <span>✈</span>
                <small>{flight.date}</small>
              </div>
              <h3>{flight.direction}</h3>
              <p class="role">{flight.airline}</p>
              <div class="segments">
                {flight.segments.map((segment) => (
                  <div class="segment">
                    <strong>{segment.from} -> {segment.to}</strong>
                    <span>{segment.departure} -> {segment.arrival}</span>
                    <small>{segment.note}</small>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
        <div class="notice">
          <strong>Выезд из дома:</strong> на рейс 18 Oct 22:20 из SVO C текущий ориентир — выехать из Солнцево около 17:00 и быть в аэропорту к 18:45-19:00.
        </div>
      </section>

      <section id="budget" class="section">
        <div class="section-head">
          <p class="eyebrow">Финансы</p>
          <h2>Пока лёгкий бюджетный контур</h2>
          <p>Excel в эту итерацию не импортируем. Здесь только категории, чтобы не потерять будущую структуру бюджета.</p>
        </div>
        <div class="budget-grid">
          {trip.budgetSummary.map((item) => (
            <article class="budget-card">
              <div class="card-topline">
                <span>₽</span>
                <small>{item.status}</small>
              </div>
              <h3>{item.category}</h3>
              <p>{item.note}</p>
            </article>
          ))}
        </div>
      </section>

      <section id="decisions" class="section">
        <div class="section-head">
          <p class="eyebrow">Решения и TBD</p>
          <h2>Что уже зафиксировано и что ещё надо решить</h2>
        </div>
        <div class="decision-grid">
          {trip.decisions.map((decision) => (
            <article class={`decision-card ${decision.status}`}>
              <span>{decision.status === "done" ? "решено" : "TBD"}</span>
              <h3>{decision.title}</h3>
              <p>{decision.details}</p>
            </article>
          ))}
        </div>
        <div class="resources">
          <h3>Ресурсы</h3>
          <div class="resource-list">
            {trip.resources.map((resource) => (
              <article>
                <strong>{resource.title}</strong>
                <span>{resource.type} · {resource.status}</span>
                {resource.url ? (
                  <a href={resource.url} target="_blank" rel="noreferrer">{resource.url}</a>
                ) : resource.type === "maps" && resource.status === "active" ? (
                  <em>Ссылки доступны в карточках дней и на карте</em>
                ) : (
                  <em>Ссылка будет добавлена позже</em>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section safety">
        <div>
          <p class="eyebrow">Правило проекта</p>
          <h2>Текст и карта завязаны на один источник</h2>
        </div>
        <p>
          Все публичные блоки сайта строятся из <code>src/data/trip.json</code>. Если меняется порядок баз, точка карты,
          день или переезд, обновляется этот файл, а сайт пересобирается. Приватные данные в публичный repo не добавляются.
        </p>
      </section>
    </main>
    <script id="trip-now-data" type="application/json" set:html={tripNowPayload} is:inline></script>
    <script is:inline>
      const tripNowData = document.getElementById("trip-now-data");
      const tripNowStatus = document.getElementById("trip-now-status");
      const tripNowTitle = document.getElementById("trip-now-title");
      const tripNowBase = document.getElementById("trip-now-base");
      const tripNowPlan = document.getElementById("trip-now-plan");
      const tripNowNote = document.getElementById("trip-now-note");
      const tripNowNext = document.getElementById("trip-now-next");
      const tripNowDayLink = document.getElementById("trip-now-day-link");
      const dayPicker = document.getElementById("day-picker");

      if (tripNowData && tripNowStatus && tripNowTitle && tripNowBase && tripNowPlan && tripNowNote && tripNowNext && tripNowDayLink && dayPicker) {
        const tripNow = JSON.parse(tripNowData.textContent || "{}");
        const monthIndex = { Oct: 9, Nov: 10 };
        const dayDate = (day) => {
          const [dayNumber, month] = day.date.split(" ");
          return new Date(tripNow.year, monthIndex[month], Number(dayNumber));
        };
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const firstDay = dayDate(tripNow.days[0]);
        const lastDay = dayDate(tripNow.days[tripNow.days.length - 1]);
        let activeIndex = tripNow.days.findIndex((day) => dayDate(day).getTime() === today.getTime());

        if (activeIndex < 0) {
          activeIndex = today < firstDay ? 0 : tripNow.days.length - 1;
        }

        const activeDay = tripNow.days[activeIndex];
        const nextDay = tripNow.days[activeIndex + 1];
        const status = today < firstDay
          ? `Маршрут начинается ${activeDay.date} ${tripNow.year}`
          : today > lastDay
            ? "Маршрут завершён"
            : `Сегодня · ${activeDay.date}`;

        tripNowStatus.textContent = status;
        tripNowTitle.textContent = activeDay.title;
        tripNowBase.textContent = `${activeDay.date} · ${activeDay.base}`;
        tripNowPlan.textContent = activeDay.plan;
        tripNowNote.textContent = activeDay.notes;
        tripNowDayLink.href = `#${activeDay.id}`;
        tripNowDayLink.textContent = `Открыть день ${activeDay.date}`;
        tripNowNext.textContent = nextDay
          ? `Следом: ${nextDay.date} · ${nextDay.title}.`
          : "Это последний день маршрута.";
        dayPicker.value = String(activeIndex);

        dayPicker.addEventListener("change", () => {
          const target = tripNow.days[Number(dayPicker.value)];
          document.getElementById(target.id)?.scrollIntoView({ behavior: "smooth", block: "start" });
        });
      }
    </script>
    <script is:inline>
      (() => {
        const storageKey = "bali-2026-personal-day-notes-v1";
        const cards = Array.from(document.querySelectorAll("[data-personal-day]"));
        const exportButton = document.getElementById("personal-export");
        const importInput = document.getElementById("personal-import");
        const clearAllButton = document.getElementById("personal-clear-all");
        const status = document.getElementById("personal-storage-status");
        const knownIds = new Set(cards.map((card) => card.dataset.personalDayId || ""));
        const emptyStore = () => ({ version: 1, days: {} });
        const isText = (value) => typeof value === "string";
        const toLines = (value) => (isText(value) ? value.split(/\r?\n/u).map((line) => line.trim()).filter(Boolean).slice(0, 80) : []);
        const normalizeEntry = (value) => {
          const entry = value && typeof value === "object" ? value : {};
          return {
            note: isText(entry.note) ? entry.note.trim().slice(0, 6000) : "",
            timing: Array.isArray(entry.timing) ? entry.timing.filter(isText).map((line) => line.trim()).filter(Boolean).slice(0, 80) : [],
            checklist: Array.isArray(entry.checklist) ? entry.checklist.filter(isText).map((line) => line.trim()).filter(Boolean).slice(0, 80) : [],
            links: Array.isArray(entry.links) ? entry.links.filter(isText).map((line) => line.trim()).filter(Boolean).slice(0, 80) : []
          };
        };
        const hasEntry = (entry) => Boolean(entry.note || entry.timing.length || entry.checklist.length || entry.links.length);
        const setStatus = (message) => {
          if (status) status.textContent = message;
        };
        const loadStore = () => {
          try {
            const raw = window.localStorage.getItem(storageKey);
            if (!raw) return emptyStore();
            const parsed = JSON.parse(raw);
            if (!parsed || typeof parsed !== "object" || !parsed.days || typeof parsed.days !== "object") return emptyStore();
            const days = Object.fromEntries(Object.entries(parsed.days)
              .filter(([id]) => knownIds.has(id))
              .map(([id, entry]) => [id, normalizeEntry(entry)])
              .filter(([, entry]) => hasEntry(entry)));
            return { version: 1, days };
          } catch {
            setStatus("Не удалось прочитать локальные записи. Начинаем с пустого списка.");
            return emptyStore();
          }
        };
        let store = loadStore();
        const persist = () => {
          try {
            if (Object.keys(store.days).length === 0) {
              window.localStorage.removeItem(storageKey);
            } else {
              window.localStorage.setItem(storageKey, JSON.stringify(store));
            }
            return true;
          } catch {
            setStatus("Браузер не дал сохранить записи локально. Проверь режим приватного просмотра и память браузера.");
            return false;
          }
        };
        const renderList = (list, values, type) => {
          list.replaceChildren();
          values.forEach((value) => {
            const item = document.createElement("li");
            if (type === "links") {
              const [rawLabel, rawTarget] = value.split("|").map((part) => part.trim());
              const target = rawTarget || rawLabel;
              const label = rawTarget ? rawLabel || rawTarget : target;
              if (/^https?:\/\//iu.test(target)) {
                const link = document.createElement("a");
                link.href = target;
                link.target = "_blank";
                link.rel = "noreferrer";
                link.textContent = label;
                item.append(link);
              } else if (/^\+?[0-9][0-9\s()\-]{5,}$/u.test(target)) {
                const link = document.createElement("a");
                link.href = `tel:${target.replace(/[^+0-9]/gu, "")}`;
                link.textContent = label;
                item.append(link);
              } else {
                item.textContent = value;
              }
            } else {
              item.textContent = value;
            }
            list.append(item);
          });
        };
        const renderCard = (card) => {
          const id = card.dataset.personalDayId || "";
          const entry = normalizeEntry(store.days[id]);
          const summary = card.querySelector("[data-personal-summary]");
          const empty = card.querySelector("[data-personal-empty]");
          const note = card.querySelector("[data-personal-note]");
          const timingBlock = card.querySelector("[data-personal-timing-block]");
          const checklistBlock = card.querySelector("[data-personal-checklist-block]");
          const linksBlock = card.querySelector("[data-personal-links-block]");
          const timingList = card.querySelector("[data-personal-timing]");
          const checklistList = card.querySelector("[data-personal-checklist]");
          const linksList = card.querySelector("[data-personal-links]");
          const present = hasEntry(entry);

          summary.hidden = !present;
          empty.hidden = present;
          note.hidden = !entry.note;
          note.textContent = entry.note;
          timingBlock.hidden = entry.timing.length === 0;
          checklistBlock.hidden = entry.checklist.length === 0;
          linksBlock.hidden = entry.links.length === 0;
          renderList(timingList, entry.timing, "text");
          renderList(checklistList, entry.checklist, "text");
          renderList(linksList, entry.links, "links");
        };
        const renderAll = () => cards.forEach(renderCard);
        const openEditor = (card) => {
          const id = card.dataset.personalDayId || "";
          const entry = normalizeEntry(store.days[id]);
          const form = card.querySelector("[data-personal-form]");
          const editButton = card.querySelector(".personal-edit");
          form.elements.note.value = entry.note;
          form.elements.timing.value = entry.timing.join("\n");
          form.elements.checklist.value = entry.checklist.join("\n");
          form.elements.links.value = entry.links.join("\n");
          form.hidden = false;
          editButton.setAttribute("aria-expanded", "true");
          form.elements.note.focus();
        };
        const closeEditor = (card) => {
          const form = card.querySelector("[data-personal-form]");
          const editButton = card.querySelector(".personal-edit");
          form.hidden = true;
          editButton.setAttribute("aria-expanded", "false");
        };

        cards.forEach((card) => {
          const form = card.querySelector("[data-personal-form]");
          const id = card.dataset.personalDayId || "";
          const label = card.dataset.personalDayLabel || "Этот день";
          card.querySelector(".personal-edit").addEventListener("click", () => openEditor(card));
          card.querySelector(".personal-cancel").addEventListener("click", () => closeEditor(card));
          card.querySelector(".personal-clear-day").addEventListener("click", () => {
            if (!store.days[id]) {
              closeEditor(card);
              return;
            }
            if (!window.confirm(`Очистить личные записи: ${label}?`)) return;
            delete store.days[id];
            persist();
            renderCard(card);
            closeEditor(card);
            setStatus(`${label}: личные записи очищены.`);
          });
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            const formData = new FormData(form);
            const entry = normalizeEntry({
              note: formData.get("note"),
              timing: toLines(formData.get("timing")),
              checklist: toLines(formData.get("checklist")),
              links: toLines(formData.get("links"))
            });
            if (hasEntry(entry)) {
              store.days[id] = entry;
            } else {
              delete store.days[id];
            }
            persist();
            renderCard(card);
            closeEditor(card);
            setStatus(`${label}: личные записи сохранены на этом устройстве.`);
          });
        });

        exportButton?.addEventListener("click", () => {
          const payload = JSON.stringify({ ...store, exportedAt: new Date().toISOString() }, null, 2);
          const url = URL.createObjectURL(new Blob([payload], { type: "application/json" }));
          const link = document.createElement("a");
          link.href = url;
          link.download = "bali-2026-lichnye-zametki.json";
          link.click();
          window.setTimeout(() => URL.revokeObjectURL(url), 0);
          setStatus("Файл с личными записями экспортирован.");
        });
        importInput?.addEventListener("change", async () => {
          const file = importInput.files?.[0];
          if (!file) return;
          try {
            const parsed = JSON.parse(await file.text());
            if (!parsed || typeof parsed !== "object" || !parsed.days || typeof parsed.days !== "object") throw new Error("format");
            const days = Object.fromEntries(Object.entries(parsed.days)
              .filter(([id]) => knownIds.has(id))
              .map(([id, entry]) => [id, normalizeEntry(entry)])
              .filter(([, entry]) => hasEntry(entry)));
            store = { version: 1, days };
            persist();
            renderAll();
            setStatus("Личные записи импортированы на это устройство.");
          } catch {
            setStatus("Не удалось импортировать файл: нужен экспорт личных записей этого сайта в JSON.");
          } finally {
            importInput.value = "";
          }
        });
        clearAllButton?.addEventListener("click", () => {
          if (Object.keys(store.days).length === 0) return;
          if (!window.confirm("Очистить все личные записи на этом устройстве? Это не затронет общий маршрут.")) return;
          store = emptyStore();
          persist();
          renderAll();
          cards.forEach(closeEditor);
          setStatus("Все личные записи на этом устройстве очищены.");
        });
        renderAll();
      })();
    </script>
  </body>
</html>
